# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Base URL used to build auth links (confirmation, password reset). In
# production this must be your real domain, e.g. https://tracker.wellflex.co
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails granted superadmin (cross-team) access.
SUPERADMIN_EMAILS=admin@example.com

# --- Cron (required for scheduled jobs on Vercel) ---
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=generate-a-long-random-string

# --- SMTP (required to send auth + notification emails) ---
# See ZOHO_SMTP_SETUP.md for Zoho specifics.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=you@wellflex.co
SMTP_PASSWORD=your-smtp-app-password
# Used by lib/utils/email.ts (auth + request emails)
SMTP_FROM_EMAIL=wetrack <noreply@wellflex.co>
# Used by lib/utils/email-reminders.ts (reminder emails)
SMTP_FROM=noreply@wellflex.co
SMTP_FROM_NAME=Wellflex

# --- Optional ---
# Comma-separated fallback recipients for request notifications.
REQUEST_NOTIFICATION_EMAILS=
